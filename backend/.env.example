CODEATLAS_ENV=development
CODEATLAS_API_BASE_URL=http://localhost:8000
CODEATLAS_DATABASE_URL=postgresql+asyncpg://codeatlas:codeatlas@localhost:5432/codeatlas
CODEATLAS_REDIS_URL=redis://localhost:6379/0
CODEATLAS_JWT_ISSUER=codeatlas
CODEATLAS_JWT_AUDIENCE=codeatlas-ios
CODEATLAS_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CODEATLAS_ACCESS_TOKEN_MINUTES=15
CODEATLAS_REFRESH_TOKEN_DAYS=30
CODEATLAS_APPLE_AUDIENCE=com.yourcompany.CodeAtlas
CODEATLAS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
CODEATLAS_MAX_REQUEST_BYTES=2000000
CODEATLAS_LOCAL_DATA_PATH=.codeatlas_data/repositories.json
CODEATLAS_GITHUB_CLIENT_ID=
CODEATLAS_GITHUB_CLIENT_SECRET=
CODEATLAS_GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/api/v1/repositories/github/oauth/callback
CODEATLAS_LLM_PROVIDER=disabled
CODEATLAS_LLM_API_KEY=
CODEATLAS_STORAGE_BACKEND=local
